# Copy to .env and fill locally. Never commit real keys.

# --- Wallets (gitignored files hold the actual keys) ---
# DEPLOYER_KEY_FILE=.secrets/deployer.key
# KEEPER_KEY_FILE=.secrets/keeper.key
# MAKER_KEY_FILE=.secrets/maker.key
DEPLOYER_PRIVATE_KEY=
KEEPER_PRIVATE_KEY=
MAKER_PRIVATE_KEY=

# --- Networks ---
ARB_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc
ROBINHOOD_TESTNET_RPC=
ANVIL_RPC=http://127.0.0.1:8545
CHAIN_ID=421614

# --- App ---
NEXT_PUBLIC_CHAIN_ID=421614
NEXT_PUBLIC_ARB_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc
NEXT_PUBLIC_WALLETCONNECT_ID=
NEXT_PUBLIC_DEMO_MODE=true
DATABASE_PATH=./data/nectar.sqlite

# Optional: authorize keeper submissions to POST /v1/jobs
KEEPER_API_TOKEN=dev-keeper-token
SIWE_DOMAIN=localhost:3000
